# ============================================================================
# USOPGRID — environment configuration
#
# Frontend (Vite) variables go in .env.local.
# Backend (Convex) variables are set on the deployment:
#   npx convex env set NAME value          (dev)
#   npx convex env set NAME value --prod   (production)
# Never commit real values. See docs/USOPGRID_DEPLOYMENT.md.
# ============================================================================

# ---- Frontend --------------------------------------------------------------
VITE_CONVEX_URL=                       # https://<deployment>.convex.cloud (from `npx convex dev`)
# VITE_USOPGRID_API_URL=               # optional custom API host, e.g. https://api.usopgrid.com
CONVEX_DEPLOYMENT=                     # written by `npx convex dev`

# ---- Backend: platform (required for production) ---------------------------
# 32 random bytes, base64. Seals provider credentials and MFA secrets (AES-256-GCM).
# Generate: openssl rand -base64 32      Losing it makes stored credentials unreadable.
USOPGRID_ENCRYPTION_KEY=
# Comma-separated emails of USOPGRID staff allowed into the operations console.
USOPGRID_PLATFORM_ADMINS=
# FX spread in basis points applied to customer quotes (default 50 = 0.50%).
USOPGRID_FX_SPREAD_BPS=50
# Signing secret the sandbox rails use for simulated inbound webhooks.
USOPGRID_SANDBOX_WEBHOOK_SECRET=

# ---- Backend: compliance + FX (optional, recommended for production) -------
OPENSANCTIONS_API_KEY=                 # consolidated sanctions screening (opensanctions.org)
FX_RATE_PROVIDER_URL=                  # premium FX source; ECB + open.er-api are used otherwise
FX_RATE_PROVIDER_KEY=

# ---- Backend: platform-owned provider accounts (optional) ------------------
# Merchants normally add their own credentials in Dashboard → Providers.
# Variables below create a USOPGRID-owned "platform" connection.
# Production uses NAME; the sandbox environment reads NAME_SANDBOX (test keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_LIVE_URL_PREFIX=
CHECKOUTCOM_SECRET_KEY=
CHECKOUTCOM_PROCESSING_CHANNEL_ID=
CHECKOUTCOM_WEBHOOK_KEY=
DLOCAL_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_SECRET_KEY=
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# e.g. STRIPE_SECRET_KEY_SANDBOX=sk_test_...

# ---- Backend: auth + misc ---------------------------------------------------
CONVEX_SITE_URL=                       # set automatically by Convex; used for webhook callback URLs
VLY_APP_NAME=USOPGRID                  # sender name on sign-in code emails
GITHUB_TOKEN=                          # optional: developer-portal repository view
